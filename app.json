{
  "expo": {
    "name": "寰澜BW",
    "slug": "blackwave-huanlan",
    "owner": "blackwaveofficials-team",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/BWlogoicon.png",
    "scheme": "blackwave-huanlan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.blackwave.huanlan",
      "buildNumber": "3",
      "icon": "./assets/images/BWlogoicon.png",
      "requireFullScreen": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "com.blackwave.huanlan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/BWlogoicon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/BWlogo.jpg",
          "imageWidth": 320,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/BWlogo.jpg",
            "imageWidth": 320
          }
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "允许 BlackWave 寰澜访问照片以导出经营图表",
          "savePhotosPermission": "允许 BlackWave 寰澜将经营图表保存到相册"
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "./plugins/withAndroidNdkVersion",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "754f7bac-e388-40a2-9972-3d417c0930ef"
      }
    }
  }
}
